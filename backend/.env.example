# Copy this file to ".env" and fill in real values.
# NEVER commit ".env" or put real credentials in this example file.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL (the only supported database)
DB_NAME=safari_travels
DB_USER=safari_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Comma-separated lists, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional
# TIME_ZONE=Africa/Nairobi
# LOG_LEVEL=INFO
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=prefer

# Booking rate limit per client IP (format: number/second|minute|hour|day)
# BOOKING_THROTTLE_RATE=5/hour
# Number of reverse proxies in front of Django (0 = none). Set this correctly
# in production, or every visitor may share one rate limit.
# NUM_PROXIES=0

# Production only (config.settings.prod)
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# USE_PROXY_SSL_HEADER=False